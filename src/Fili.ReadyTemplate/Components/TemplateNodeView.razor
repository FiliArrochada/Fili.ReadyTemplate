@inject IStringLocalizer<Strings> L

<li>
    <a href="@Node.Template.Href">@L[Node.Template.Key]</a>
    @if (Node.Children.Count > 0)
    {
        <ul>
            @foreach (var child in Node.Children)
            {
                <TemplateNodeView Node="child" />
            }
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired] public required TemplateNode Node { get; set; }
}
