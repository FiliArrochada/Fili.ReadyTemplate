<Project>

  <!-- SHARED BLOCK - keep it exactly as it is, byte for byte. Put this repo's own settings below the separator, in this same file. -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Binding redirects for projects that carry an app.config or a web.config.
       GenerateBindingRedirectsOutputType extends the generation to library and test outputs, which are skipped otherwise. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/app.config') Or Exists('$(MSBuildProjectDirectory)/web.config')">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- ================================ end of shared block ================================ -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Release identity. The version is shown in the site's navigation bar (AppInfo.Version). -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Product>Fili.ReadyTemplate</Product>
    <Company>FiliArrochada</Company>
    <Authors>FiliArrochada</Authors>
    <Copyright>Templates copyright 2003-2004 Jason Robbins (ReadySET license); site copyright 2026 FiliArrochada</Copyright>
    <RepositoryUrl>https://github.com/FiliArrochada/Fili.ReadyTemplate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
